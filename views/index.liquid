<!DOCTYPE html>
<html>
  <head>
    <title>{{ shop.name }}</title>
  </head>
  <body>
    <h1>歡迎來到 {{ shop.name }}</h1>
    <p>目前幣別：{{ shop.currency }}</p>

    {% if shop.products.size > 0 %}
      <ul>
        {% for p in shop.products %}
          <li>{{ p.name }} - {{ p.price }} {{ shop.currency }}</li>
        {% endfor %}
      </ul>
    {% else %}
      <p>暫無商品</p>
    {% endif %}
  </body>
</html>

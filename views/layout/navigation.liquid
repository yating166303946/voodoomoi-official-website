<nav class="NewNavigationBar mod-desktop visible-lg">

  <div class="NewNavigationBar-container">
    <!-- Left action btns -->
    {% if page.identifier != 'checkout' %}
      <ul class="NewNavigationBar-actionMenu">
        <!-- Language chooser -->
        <li class="List-item">
          <div class="NewNavigationBar-actionMenu-button App-languageDropdown dropdown" dropdown>
            <div class="dropdown-toggle" dropdown-toggle>
              <span class="fa fa-globe"></span>
              <span class="Label">{{ shop.current_locale.name }}</span>
              <span class="fa fa-angle-down"></span>
            </div>
            <ul class="NewNavigationBar-actionMenu-dropdown dropdown-menu sl-language-chooser">
              {% for locale in shop.supported_locales %}
                <li class="List-item sl-language-chooser-language" href="#{{ locale.code }}">{{ locale.name }}</li>
              {% endfor %}
            </ul>
          </div>
        </li>

        <!-- Currency chooser -->
        {% if shop.multicurrency_enabled %}
          <li class="List-item">
            <div class="NewNavigationBar-actionMenu-button App-currencyDropdown dropdown" dropdown>
              <div class="dropdown-toggle" dropdown-toggle>
                <span class="Label"><span class="fa fa-dollar"></span></span>
                <span class="fa fa-angle-down"></span>
              </div>
              <ul class="NewNavigationBar-actionMenu-dropdown dropdown-menu sl-currency-chooser">
                {% for currency in shop.supported_currencies %}
                  <li class="List-item sl-currency-chooser-currency" href="#{{ currency.iso_code }}">{{ currency.name }}</li>
                {% endfor %}
              </ul>
            </div>
          </li>
        {% endif %}

        <!-- Messages -->
        {% if shop.messages_enabled %}
          <li class="List-item">
            <a class="NewNavigationBar-actionMenu-button MessageDialog-showButton sl-message-toggle">
              <span class="fa fa-comments-o"></span>
            </a>
          </li>
        {% endif %}
      </ul>
    {% endif %}

    <!-- Right action btns -->
    {% if page.identifier != 'checkout' %}
      <ul class="NewNavigationBar-actionMenu">
        {% if customer == blank %}
          <!-- Sign-in button -->
          <li class="List-item">
            <a href="/users/sign_in" class="NewNavigationBar-actionMenu-button">
              <span class="fa fa-user"></span>
            </a>
          </li>
        {% else %}
          <!-- Member Center button -->
          <li class="List-item">
            <a href="/users/{{ customer.id }}/edit" class="NewNavigationBar-actionMenu-button">
              <span class="fa fa-user-circle"></span>
            </a>
          </li>
        {% endif %}

        <!-- Cart panel toggle -->
        <li class="List-item">
          <a class="NewNavigationBar-actionMenu-button CartPanel-toggleButton sl-cart-toggle">
            <span class="fa fa-shopping-cart"></span>
            <span class="Cart-count sl-cart-count"></span>
          </a>
        </li>
      </ul>
    {% endif %}
  </div>

  <!-- Logo -->

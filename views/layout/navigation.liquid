<nav
  id="nav-bar"
  class="mod-desktop visible-lg w-screen bg-neutral-0 fixed top-0 z-50 py-9 px-10 transition duration-500 ease-in-out [&.scrolled]:bg-neutral-0 [&.scrolled]:py-6 [&.scrolled]:px-9 [&.scrolled]:shadow-lg/4 [&.scrolled]:shadow-black data-[page=home]:bg-transparent"
  data-page="{% if page.url == '/' %}home{% else %}else{% endif %}"
  >
  <!-- 操作選單 -->
  <div class="w-full flex justify-between items-center flex-wrap gap-y-15 [#nav-bar.scrolled_&]:items-start">
    <!-- Left action btns -->
    {% if page.identifier != 'checkout' %}
      <ul class="flex-1 flex justify-start items-center gap-x-4 [#nav-bar.scrolled_&]:hidden">
        <!-- Language chooser -->
        <li class="text-caption-serif-semibold">
          <div class="cursor-pointer App-languageDropdown dropdown" dropdown>
            <div class="dropdown-toggle flex gap-x-2" dropdown-toggle>
              <div class="size-5 icon icon-lang [#nav-bar[data-page=home]:not(.scrolled)_&]:bg-neutral-0"></div>
              <div class="text-primary-100 inline-block align-bottom mt-1 [#nav-bar[data-page=home]:not(.scrolled)_&]:text-neutral-0">{{ shop.current_locale.name }}</div>
            </div>
            <ul class="dropdown-menu sl-language-chooser border! border-primary-100! shadow-none! px-4! py-3!">
              {% for locale in shop.supported_locales %}
                <li class="text-caption-serif-semibold! sl-language-chooser-language" href="#{{ locale.code }}">
                  {{ locale.name }}
                </li>
              {% endfor %}
            </ul>
          </div>
        </li>

        <!-- Messages -->
        {% if shop.messages_enabled %}
          <li class="text-caption-serif-semibold">
            <a class="flex gap-x-2 cursor-pointer MessageDialog-showButton sl-message-toggle">
              <div class="size-5 icon icon-help [#nav-bar[data-page=home]:not(.scrolled)_&]:bg-neutral-0"></div>
              <div class="text-primary-100 inline-block align-bottom mt-1 [#nav-bar[data-page=home]:not(.scrolled)_&]:text-neutral-0">{{ 'nav.btn_message' | translate }}</div>
            </a>
          </li>
        {% endif %}
      </ul>
    {% endif %}

    <!-- Logo -->
    <a class="flex-1 text-center [#nav-bar.scrolled_&]:text-left!" href="/">
      <div class="logo aspect-[388/53] w-[clamp(200px,20vw,388px)] [#nav-bar.scrolled_&]:w-[clamp(140px,12vw,232.5px)] [#nav-bar[data-page=home]:not(.scrolled)_&]:bg-neutral-0"></div>
    </a>

    <!-- Right action btns -->
    {% if page.identifier != 'checkout' %}
      <ul class="flex-1 flex justify-end items-center gap-x-4 [#nav-bar.scrolled_&]:order-last">
        <!-- (when scrolled y axis) Language chooser -->
        <li class="text-caption-serif-semibold [display:none] [#nav-bar.scrolled_&]:block">
          <div class="cursor-pointer App-languageDropdown dropdown" dropdown>
            <div class="flex gap-x-2 dropdown-toggle" dropdown-toggle>
              <div class="size-5 icon icon-lang [#nav-bar[data-page=home]:not(.scrolled)_&]:bg-neutral-0"></div>
              <div class="text-primary-100 inline-block align-bottom mt-1 [#nav-bar[data-page=home]:not(.scrolled)_&]:text-neutral-0">{{ shop.current_locale.name }}</div>
            </div>
            <ul class="dropdown-menu sl-language-chooser border! border-primary-100! shadow-none! px-4! py-3!">
              {% for locale in shop.supported_locales %}
                <li class="text-caption-serif-semibold! sl-language-chooser-language" href="#{{ locale.code }}">
                  {{ locale.name }}
                </li>
              {% endfor %}
            </ul>
          </div>
        </li>
        
        <!-- Currency chooser -->
        {% if shop.multicurrency_enabled %}
          <li class="text-caption-serif-semibold">
            <div class="cursor-pointer App-currencyDropdown dropdown" dropdown>
              <div class="flex gap-x-1 dropdown-toggle" dropdown-toggle>
                <div class="size-5 icon icon-currency [#nav-bar[data-page=home]:not(.scrolled)_&]:bg-neutral-0"></div>
                <div class="text-primary-100 inline-block align-bottom mt-1 [#nav-bar[data-page=home]:not(.scrolled)_&]:text-neutral-0">{{ shop.currency }}</div>
              </div>
              <ul class="dropdown-menu sl-currency-chooser border! border-primary-100! shadow-none! px-4! py-3!">
                {% for currency in shop.supported_currencies %}
                  <li class="text-caption-serif-semibold! sl-currency-chooser-currency" href="#{{ currency.iso_code }}">
                    {{ currency.name }}
                  </li>
                {% endfor %}
              </ul>
            </div>
          </li>
        {% endif %}

        {% if customer == blank %}
          <!-- Sign-in button -->
          <li class="text-caption-serif-semibold [#nav-bar.scrolled_&]:hidden">
            <a href="/users/sign_in" class="flex gap-x-2 cursor-pointer">
              <div class="size-5 icon icon-user [#nav-bar[data-page=home]:not(.scrolled)_&]:bg-neutral-0"></div>
              <div class="text-primary-100 inline-block align-bottom mt-1 [#nav-bar[data-page=home]:not(.scrolled)_&]:text-neutral-0">{{ 'nav.btn_account' | translate }}</div>
            </a>
          </li>
        {% else %}
          <!-- Member Center button -->
          <li class="text-caption-serif-semibold [#nav-bar.scrolled_&]:hidden">
            <a href="/users/{{ customer.id }}/edit" class="cursor-pointer">
              <div class="text-primary-100 inline-block align-bottom mt-1 [#nav-bar[data-page=home]:not(.scrolled)_&]:text-neutral-0" class="icon fa fa-user-circle"></div>
            </a>
          </li>
        {% endif %}

        <!-- y 軸滾動時的 search -->
        {% comment %} <label for="vdm-search" class="hidden group transition-all [#nav-bar.scrolled_&]:block!">
          <div class="flex gap-x-2 cursor-pointer text-caption-serif-semibold">
            <div class="size-5 icon icon-find [#nav-bar[data-page=home]:not(.scrolled)_&]:bg-neutral-0"></div>

            <!-- 平時顯示 -->
            <span class="mt-[3px] text-primary-100 group-focus-within:hidden [#nav-bar[data-page=home]:not(.scrolled)_&]:text-neutral-0">{{ 'nav.btn_search' | translate }}</span>

            <!-- 點擊後顯示 -->
            <form class="sl-product-search opacity-0 w-0 transition-all duration-300 group-focus-within:opacity-100 group-focus-within:w-full">
              <input
                id="vdm-search"
                class="outline-none bg-transparent"
                placeholder="{{ 'shopline_translations.themes.search' | translate }}"
                maxlength="100"
                disabled
                >
            </form>
          </div>
        </label> {% endcomment %}

        <!-- Cart panel toggle -->
        <li class="text-caption-serif-semibold">
          <a class="flex gap-x-2 cursor-pointer CartPanel-toggleButton sl-cart-toggle">
            <div class="size-5 icon icon-cart [#nav-bar[data-page=home]:not(.scrolled)_&]:bg-neutral-0"></div>
            <span class="Cart-count sl-cart-count"></span>
            <div class="text-primary-100 inline-block align-bottom mt-1 [#nav-bar[data-page=home]:not(.scrolled)_&]:text-neutral-0">{{ 'nav.btn_cart' | translate }}</div>
          </a>
        </li>
      </ul>
    {% endif %}

    <!-- 頁面選單 -->
    {% if page.identifier != 'checkout' %}
      <div class="basis-full relative [#nav-bar.scrolled_&]:flex-[2] [#nav-bar.scrolled_&]:mt-1">

        <ul class="flex justify-center items-start gap-8">
          {% for link in linklists.main-menu.links %}
            <li class="group text-body-serif-semibold List-mother">
              <a
                class="relative inline-block text-primary-100! text-nowrap [#nav-bar[data-page=home]:not(.scrolled)_&]:text-neutral-0!"
                link-highlight="{{ link.url }}"
                href="{{ link.url }}"
                target="{{ link.target }}"
                >
                {{ link.title }}
                <!-- 底線動畫 -->
                <span
                  class="absolute left-0 -bottom-2 h-[2px] w-0 bg-current transition-all duration-300 group-hover:w-full"
                ></span>
              </a>

              {% if link.children != empty %}
                <div class="w-4 overflow-visible mt-0 group-hover:mt-10">
                  <ul class="w-max flex flex-col gap-y-4 items-start overflow-hidden h-0 opacity-0 group-hover:h-auto group-hover:opacity-100 transition-all duration-300">
                    {% for sublink in link.children.links %}
                      <li class="text-body-serif-semibold">
                        <a
                          class="text-primary-100! [#nav-bar[data-page=home]:not(.scrolled)_&]:text-neutral-0!"
                          link-highlight="{{ link.url }}"
                          href="{{ sublink.url }}"
                          target="{{ sublink.target }}"
                          >
                          {{ sublink.title }}
                        </a>
                      </li>
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}

            </li>
          {% endfor %}
        </ul>

        <!-- Search -->
        <div class="absolute right-[clamp(40px,2vw,216px)] top-0 flex gap-x-2 cursor-pointer text-caption-serif-semibold [#nav-bar.scrolled_&]:hidden max-[1200px]:hidden">
          <div class="border-l border-primary-100 h-[52px] absolute -left-4 -top-4 [#nav-bar[data-page=home]:not(.scrolled)_&]:border-neutral-0"></div>
          <div class="size-5 icon icon-find [#nav-bar[data-page=home]:not(.scrolled)_&]:bg-neutral-0"></div>
          <form class="sl-product-search">
            <input disabled maxlength="100" placeholder="{{ 'shopline_translations.themes.search' | translate }}">
          </form>
        </div>

      </div>
    {% endif %}
  </div>
</nav>



<!-- Brand Story -->
{% if shop.current_locale.code == "zh-hant" %}
  {% assign brandStoryTitle = "好魔品牌故事" %}
  {% assign brandStoryContent = "原意為向自己許願，祈願自麗，源於古法文雅韻 VOEU de MOI 的好魔 VÖODÖOMÖI，結合台北、東京、與巴黎三地兼有生醫、妝品與美學青創，願與你同行，喚醒深埋在肌膚與心緒裡，獨一無二的美。好魔 VÖODÖOMÖI 相信美麗源自肌膚與心緒的交互協同，從生醫出發，師法並擷取自然植物，誠心打造最適合肌膚與心緒的保養產品，讓美麗能由內而外綻放。創辦人 Ｄr. Joseph Wan 深受高級香水動人香華啟發，透過保養產品與調香體驗，透過五感讓美麗在舉手投足間，自然開展。" %}
  {% assign brandStoryButton = "關於好魔" %}
{% else %}
  {% assign brandStoryTitle = "BRAND STORY" %}
  {% assign brandStoryContent = "Conjured from VŒU DE MOI, the ultimate wish for self-fulfillment and self-love, VÖODÖOMÖI offers skin and body care solutions. The founder, Dr. Joseph Wan, believes in the neuro-sensory benefits of fragrance to mind and body, and crafts the full array of organic and fragrant skin and home products. His expertise in functional imaging and respiratory diseases enable him to explore the potentials of the liaison in between olfaction and holistic wellness." %}
  {% assign brandStoryButton = "About VÖODÖOMÖI" %}
{% endif %}

